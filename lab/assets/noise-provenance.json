  "equation": "d theta_ij = [sin(theta_ij)+(D-alpha)(theta_i+1,j-theta_ij)-(D+alpha)(theta_ij-theta_i-1,j)+D(theta_i,j+1+theta_i,j-1-2theta_ij)] dt + sigma dW_ij",
